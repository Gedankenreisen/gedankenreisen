ut type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-12 col-lg-{{cardWidth}}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".card-text\"><b>🌳 Die Bank unter der Linde</b><br><br><b><br></b><br><br>Am Rand eines kleinen Weges stand eine alte Bank.<br><br><br><br>Aus Holz, das schon viele Sommer gesehen hatte.<br><br><br><br>Unter einer Linde, die den Tag über ihre Blätter rauschen ließ und am Abend die Sterne zählte.<br><br><br><br>Hier blieb man nicht stehen, weil man irgendwohin musste.<br><br><br><br>Hier blieb man stehen, weil man kurz bei sich ankommen wollte.<br><br><br><br>Manche setzten sich, wenn sie müde waren.<br><br><br><br>Manche, wenn sie traurig waren.<br><br><br><br>Manche, wenn sie dankbar waren.<br><br><br><br>Und manche einfach, weil die Linde so schön erzählt hat.<br><br><br><br>Die Bank fragte nie nach.<br><br><br><br>Sie hörte nur zu.<br><br><br><br>Und manchmal reichte das schon.<br><br><br><br>🌿<br><br><br><br>Nimm dir einen Moment.<br><br><br><br>Für <b><i>dich</i></b>. Für <b><i>jetzt</i></b>. Für dein <b><i>Herz</i></b>.<br><br><br><br><br><br><br><a href=\"https://youtu.be/CbHeVxjergo?si=jWLe6gu8u7lqV_Kv\" class=\"text-primary\">🎵 Wer mag, kann diese Gedankenreise mit folgendem Lied begleiten:</a><br><br><a href=\"https://youtu.be/CbHeVxjergo?si=jWLe6gu8u7lqV_Kv\" class=\"text-primary\">Johannes Oerding – Ein guter Tag</a><br><br><br><br><br><br></p>\n                        <div class=\"img-wrapper mt-4 {{contentAlign}}\" mbr-if=\"showImage\">\n                            <img src=\"../_images/people/team1.jpg\" alt data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                        </div>\n                        <p class=\"card-title mbr-fonts-style mt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".card-title\">\n                            <b>Sarah Jones</b>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
